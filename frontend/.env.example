VITE_API_URL=http://localhost:5000/api

# Used for canonical URLs, Open Graph, and sitemap. Set to your production
# origin (no trailing slash) in deployments; falls back to the Vite dev server.
VITE_SITE_URL=http://localhost:5173

# The backend generates sitemap.xml and robots.txt (see backend/.env PUBLIC_SITE_URL).
# In production, set VITE_SITE_URL (frontend) and PUBLIC_SITE_URL (backend) to the
# same origin so canonical URLs, the sitemap, and robots.txt agree.
