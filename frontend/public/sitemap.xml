<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for ShopEase.

  This is intentionally minimal. Only the public indexable Home page is listed:
  the dynamic /products/:id URLs require a backend-driven sitemap endpoint that
  enumerates product IDs — Sprint 7B Part 1 chose not to fake those URLs and the
  project has no build-time step that fetches the product list.

  Before deploying:
    1. Set VITE_SITE_URL in your frontend environment to the production origin
       (no trailing slash), e.g. https://shop.example.com.
    2. Replace ${VITE_SITE_URL} below with that origin.
    3. Add `Sitemap: https://shop.example.com/sitemap.xml` to robots.txt.
    4. To include product URLs, generate this file from the backend's product
       index and serve it from the API origin. That is out of scope for Part 1.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>${VITE_SITE_URL}</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
