PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shopease
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Public origin used to build absolute URLs in the backend-generated sitemap.xml
# and robots.txt. Mirrors the frontend VITE_SITE_URL strategy; in production set
# this to the same origin as VITE_SITE_URL (no trailing slash). Defaults to the
# Vite dev server origin when unset.
PUBLIC_SITE_URL=http://localhost:5173
